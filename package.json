{
  "name": "mysqlsync",
  "version": "3.0.0",
  "description": "MySQL / SQLite schema sync tool — snapshot your schema to DBML and restore it anywhere",
  "license": "ISC",
  "author": "Sergey Romanov <serg4172@mail.ru>",
  "repository": {
    "type": "git",
    "url": "https://github.com/serhioromano/mysqlsync.git"
  },
  "bin": {
    "mysqlsync": "bin/mysqlsync"
  },
  "files": [
    "bin/"
  ],
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "cpu": [
    "x64",
    "arm64"
  ],
  "engines": {
    "node": ">=12"
  },
  "keywords": [
    "mysql",
    "sqlite",
    "schema",
    "migration",
    "dbml",
    "sync",
    "cli"
  ],
  "scripts": {
    "prepack": "make build",
    "build": "make build",
    "pack": "make pack",
    "bump": "make bump",
    "release": "make release",
    "clean": "make clean",
    "snash": "go run . snash -p=dev",
    "restore": "go run . restore -p=prod"
  }
}
